# Local Ollama is the zero-configuration default.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Set true only when OLLAMA_BASE_URL intentionally points off this machine.
OLLAMA_ALLOW_REMOTE=false

# NeuralLoom app sign-in is off for local use. Ollama Cloud still requires an Ollama account.
# Enable this setting for a shared NeuralLoom deployment.
VITE_AUTH_ENABLED=false
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Optional isolated workspace runner. Off by default: workspace-dependent checks
# stay "skip" (never counted as a pass) until you enable and configure this.
# When enabled, NeuralLoom copies NEURALLOOM_SANDBOX_WORKSPACE into a disposable
# temp directory, applies the model's patch there only (never your working tree),
# and runs the commands below with a secret-scrubbed environment.
NEURALLOOM_SANDBOX_ENABLED=false
# Absolute path to a prepared workspace to snapshot (dependencies already
# installed, or installed by a command below). Required when the runner is on.
NEURALLOOM_SANDBOX_WORKSPACE=
# Check commands. Any left blank stay "skip". These come only from this config,
# never from model output.
NEURALLOOM_SANDBOX_CMD_FORMATTER=
NEURALLOOM_SANDBOX_CMD_LINTER=
NEURALLOOM_SANDBOX_CMD_TYPE_CHECKER=
NEURALLOOM_SANDBOX_CMD_UNIT_TESTS=
NEURALLOOM_SANDBOX_CMD_INTEGRATION_TESTS=
NEURALLOOM_SANDBOX_CMD_COVERAGE_GATE=
NEURALLOOM_SANDBOX_CMD_DEPENDENCY_AUDIT=
# Tuning (optional). Defaults shown.
# NEURALLOOM_SANDBOX_ROOT=            # parent dir for the temp snapshot (default: OS temp dir)
# NEURALLOOM_SANDBOX_TIMEOUT_MS=120000
# NEURALLOOM_SANDBOX_MAX_BYTES=16000
# NEURALLOOM_SANDBOX_COPY_IGNORE=node_modules,.git
# NEURALLOOM_SANDBOX_PASS_ENV=        # extra env var names to allow into the sandbox
