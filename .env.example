# Local Ollama is the zero-configuration default.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Set true only when OLLAMA_BASE_URL intentionally points off this machine.
OLLAMA_ALLOW_REMOTE=false

# Optional hosted providers. Add an API key to make that service's models
# selectable in Models. Keys stay on the server and are never sent to the
# browser. Every hosted model counts as cloud: local-only data never routes
# to it, even with a base-URL override.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Base-URL overrides (optional). Non-loopback overrides must use https.
# OPENAI_BASE_URL also works for any OpenAI-compatible server.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# XAI_BASE_URL=https://api.x.ai/v1

# NeuralLoom app sign-in is off for local use. Ollama Cloud still requires an Ollama account.
# Enable this setting for a shared NeuralLoom deployment.
VITE_AUTH_ENABLED=false
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Opt-in repository automation. In the single-user local app, tasks may index a
# local folder under these roots or clone a public HTTPS URL into a disposable
# directory. Separate multiple roots with the platform path delimiter (`;` on
# Windows, `:` on macOS/Linux). Shared deployments fail closed until per-user
# workspace isolation is available.
NEURALLOOM_REPOSITORY_ENABLED=false
# Defaults to the NeuralLoom process working directory when omitted.
NEURALLOOM_REPOSITORY_ROOTS=
# Comma-separated HTTPS clone host allowlist.
NEURALLOOM_REPOSITORY_HOSTS=github.com
# NEURALLOOM_REPOSITORY_MAX_FILES=80
# NEURALLOOM_REPOSITORY_MAX_BYTES=96000
# NEURALLOOM_REPOSITORY_MAX_FILE_BYTES=128000
# NEURALLOOM_REPOSITORY_TEMP_ROOT=      # parent for disposable clones and copies

# Optional isolated workspace runner. Off by default: workspace-dependent checks
# stay "skip" (never counted as a pass) until you enable and configure this.
# When enabled, NeuralLoom copies NEURALLOOM_SANDBOX_WORKSPACE into a disposable
# temp directory, applies the model's patch there only (never your working tree),
# and runs the commands below with a secret-scrubbed environment.
NEURALLOOM_SANDBOX_ENABLED=false
# Absolute path to a prepared workspace to snapshot (dependencies already
# installed, or installed by a command below). A repository selected in the task
# supplies this automatically; otherwise this setting is required.
NEURALLOOM_SANDBOX_WORKSPACE=
# `copy` runs operator-configured checks in a disposable copy. `container` also
# puts those checks in the network-disabled OCI container configured below.
NEURALLOOM_SANDBOX_MODE=copy
# Check commands. Any left blank stay "skip". These come only from this config,
# never from model output.
NEURALLOOM_SANDBOX_CMD_FORMATTER=
NEURALLOOM_SANDBOX_CMD_LINTER=
NEURALLOOM_SANDBOX_CMD_TYPE_CHECKER=
NEURALLOOM_SANDBOX_CMD_UNIT_TESTS=
NEURALLOOM_SANDBOX_CMD_INTEGRATION_TESTS=
NEURALLOOM_SANDBOX_CMD_COVERAGE_GATE=
NEURALLOOM_SANDBOX_CMD_DEPENDENCY_AUDIT=
# Tuning (optional). Defaults shown.
# NEURALLOOM_SANDBOX_ROOT=            # parent dir for the temp snapshot (default: OS temp dir)
# NEURALLOOM_SANDBOX_TIMEOUT_MS=120000
# NEURALLOOM_SANDBOX_MAX_BYTES=16000
# NEURALLOOM_SANDBOX_COPY_IGNORE=node_modules,.git
# NEURALLOOM_SANDBOX_PASS_ENV=        # extra env var names to allow into the sandbox

# OCI isolation for reviewed model-generated commands and, when selected above,
# workspace checks. The image must already exist locally; NeuralLoom never pulls
# or builds it. It must provide `/bin/sh` plus the required toolchain. Commands
# run against a disposable copy with no network, a read-only root filesystem,
# dropped capabilities, bounded resources, no app
# credentials, and a second explicit user confirmation.
NEURALLOOM_CONTAINER_ENABLED=false
NEURALLOOM_CONTAINER_RUNTIME=docker
NEURALLOOM_CONTAINER_IMAGE=
# NEURALLOOM_CONTAINER_TIMEOUT_MS=120000
# NEURALLOOM_CONTAINER_MAX_BYTES=32000
# NEURALLOOM_CONTAINER_MEMORY=1g
# NEURALLOOM_CONTAINER_CPUS=1
# Comma-separated snapshot exclusions. `node_modules` is included by default so
# already-installed dependencies remain usable without container network access.
# NEURALLOOM_CONTAINER_COPY_IGNORE=.git,dist,build,.next,.tanstack,.vercel,coverage

# Remote actions are separate, post-review adapters. They require the action to
# have been approved in the task, an allowlisted target, an authorization record,
# an accepted critic/check result, and a second confirmation. Use least-privilege
# credentials. Values below are server-only and must never be committed.
NEURALLOOM_GITHUB_TOKEN=
# Comma-separated owner/repository allowlist used for PR merges and releases.
NEURALLOOM_GITHUB_REPOSITORIES=
# Generic HTTPS deployment endpoint. A successful request means only that the
# endpoint accepted it; deployment health still requires external verification.
NEURALLOOM_DEPLOY_WEBHOOK_URL=
NEURALLOOM_DEPLOY_WEBHOOK_TOKEN=
# Comma-separated environment names accepted as the deployment target field.
NEURALLOOM_DEPLOY_TARGETS=
